FROM mambaorg/micromamba:1.5.10-bookworm-slim

LABEL maintainer="Enrique Doster <enriquedoster@gmail.com>"
LABEL org.opencontainers.image.title="AMR++ SNV"
LABEL org.opencontainers.image.description="NGLess + metaSNV environment for the AMR++ SNV subworkflow"
LABEL org.opencontainers.image.version="4.0.0"
LABEL org.opencontainers.image.source="https://github.com/Microbial-Ecology-Group/AMRplusplus"

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

USER root
RUN apt-get update -q && apt-get install -q -y --no-install-recommends procps g++ \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY envs/AMR++_SNV_env.yaml /tmp/AMR++_SNV_env.yaml
RUN micromamba install -y -n base -f /tmp/AMR++_SNV_env.yaml && \
    micromamba clean --all --yes

ENV PATH="/opt/conda/bin:${PATH}"

RUN cat /opt/conda/bin/ngless; ls -la /opt/conda/bin/ngless*; command -v readlink realpath dirname

#RUN ngless --version && \
#    samtools --version | head -n 1 && \
#    command -v bwa && command -v metaSNV.py && \
#    python3 -c "import numpy, pandas"

RUN chmod -R a+rX /opt/conda
