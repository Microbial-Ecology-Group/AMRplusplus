process {
  executor = 'local'           // The type of system the processes are being run on (do not modify this)
  maxForks = 4                 // The maximum number of forks a single process is allowed to spawn
  container = 'enriquedoster/amrplusplus:4.0.0'
  // SNV subworkflow processes targeting
  withName: 'ngless_filter_snv|index_snv_bams|run_metasnv|clean_metasnv|filter_snv_matrix' {
       container = 'enriquedoster/amrplusplus_snv:4.0.0'
  }
  withLabel: 'qiime2' { 
      container = 'enriquedoster/qiime2:latest'
  }
  cpus = params.threads
}